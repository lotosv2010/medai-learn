# 环境变量示例
# 复制成 .env.local 后填入真实值：cp .env.local.example .env.local
# .env.local 已被 git 忽略，切勿提交真实密钥

# ── AI 模型（阶段一至少配两家，用于跨模型对比）──────────────
# DeepSeek：https://platform.deepseek.com/api_keys（阶段一主力，最便宜）
DEEPSEEK_API_KEY=

# 阿里云百炼 / 通义千问 DashScope：https://bailian.console.aliyun.com/?tab=model#/api-key
DASHSCOPE_API_KEY=

# Anthropic Claude：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── 数据库（阶段四 RAG 起才需要）──────────────────────────
DATABASE_URL=
REDIS_URL=

# ── 认证（阶段二起才需要）────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
